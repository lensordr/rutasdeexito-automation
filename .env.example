# Rutas de Exito - Dispatch environment configuration (backend)
# Copy to backend/.env and fill in when connecting real integrations.

# Server
DISPATCH_HOST=127.0.0.1
DISPATCH_PORT=8010
DISPATCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite by default; switch to Postgres for hosted multi-company)
# DISPATCH_DATABASE_URL=postgresql+psycopg://user:pw@host/dispatch

# Email, GPS, and TMS credentials are entered through the UI
# and stored in backend/data/connector_config.json (gitignored).
